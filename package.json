{
  "name": "my24frontend",
  "version": "0.1.0",
  "private": true,
  "licence": "MIT",
  "type": "module",
  "scripts": {
    "serve": "vite preview",
    "build": "vite build",
    "dev": "vite",
    "codegen": "openapi-ts && node scripts/annotate-endpoints.mjs && node scripts/generate-resources.mjs",
    "cleanup-imports": "node scripts/remove-auto-imports.mjs",
    "use-api-namespace": "node scripts/codemods/use-api-namespace.mjs",
    "lint": "node --max-old-space-size=8192 scripts/lint.mjs",
    "lint:fix": "node --max-old-space-size=8192 scripts/lint.mjs --fix",
    "lint:i18n": "eslint --cache --cache-location node_modules/.cache/eslint-i18n/ --config eslint.i18n.config.js --concurrency auto src",
    "typecheck": "vue-tsc --noEmit",
    "usage-gate": "node scripts/usage-gate.mjs",
    "test": "vitest run",
    "test:profile": "node scripts/vitest-profile.mjs",
    "test:watch": "vitest",
    "test:mutation": "stryker run --incremental --reporters clear-text,progress,html,json"
  },
  "dependencies": {
    "@fullcalendar/bootstrap5": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "@ivanv/vue-collapse-transition": "^1.0.2",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-table": "^9.2.3",
    "@valibot/i18n": "^1.3.0",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.4.0",
    "async": "3.2.2",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "1.15.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^0.42.0",
    "chart.js": "3",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.1.0",
    "dinero.js": "^1.9.1",
    "moment": "^2.31.0",
    "pinia": "^3.0.4",
    "popper.js": "^2.0.0-next.4",
    "valibot": "^1.4.2",
    "vue": "^3.5.43",
    "vue-chartjs": "^4.1.2",
    "vue-loading-overlay": "^6.0.6",
    "vue-moment": "^4.1.0",
    "vue-multiselect": "^3.4.0",
    "vue-router": "^5.3.1",
    "vue-simple-password-meter": "^1.3.4",
    "vue-spinners": "^1.0.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@iconify-json/bi": "^1.2.7",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@pinia/testing": "^1.0.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dinero.js": "^1.9.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.11",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "color": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-typed-vue": "github:Evertt/eslint-plugin-typed-vue#claude/eslint-plugin-typed-vue-issue-cv8xp5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.11.2",
    "jsonc-eslint-parser": "^3.3.0",
    "msw": "^2.15.0",
    "sass": "^1.49.8",
    "stryker-vue-ignorer": "github:davidlandais/stryker-vue-ignorer",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "type-fest": "^5.9.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "7.3.1",
    "vite-plugin-theme-preprocessor": "https://codeberg.org/My24Service/vite-plugin-theme-preprocessor.git#develop",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9",
    "yaml": "^2.9.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "packageManager": "pnpm@12.6.0"
}
